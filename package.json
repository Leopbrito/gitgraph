{
  "name": "git-graph-tui",
  "version": "0.1.0",
  "description": "A CLI that shows the branch graph of a git repository in the terminal, with an interactive interface",
  "keywords": [
    "git",
    "graph",
    "tui",
    "terminal",
    "cli",
    "branches",
    "commits",
    "ink"
  ],
  "author": "Leonardo Brito",
  "license": "MIT",
  "homepage": "https://github.com/Leopbrito/gitgraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leopbrito/gitgraph.git"
  },
  "bugs": {
    "url": "https://github.com/Leopbrito/gitgraph/issues"
  },
  "type": "module",
  "bin": {
    "gitgraph": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
